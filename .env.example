# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Postgres
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# DHIS2 (official Sierra Leone demo, via the DHIS2 demo service alias -
# this redirects to a versioned play.im.dhis2.org host that changes
# over time, so don't hardcode the resolved host here)
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_TIMEOUT_SECONDS=

# FHIR conformity validator (self-hosted HAPI FHIR R4 server, see
# docker-compose.yml's fhir-validator service)
FHIR_VALIDATOR_URL=
FHIR_VALIDATOR_TIMEOUT_SECONDS=
