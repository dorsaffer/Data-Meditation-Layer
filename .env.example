# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres
POSTGRES_DB=mediation
POSTGRES_USER=mediation
POSTGRES_PASSWORD=mediation
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DHIS2 (official Sierra Leone demo, via the DHIS2 demo service alias -
# this redirects to a versioned play.im.dhis2.org host that changes
# over time, so don't hardcode the resolved host here)
DHIS2_BASE_URL=https://play.dhis2.org/dev
DHIS2_USERNAME=admin
DHIS2_PASSWORD=district
DHIS2_TIMEOUT_SECONDS=15
